{
  "name": "@ljwei-stak/dsh-boot-animation",
  "version": "0.3.0",
  "description": "鲸鱼娘启动加载动画：点击进入（Esc/空格放行）、多片随机、启动进度可见、失败有兜底。不改 DSH 本体源码。",
  "license": "MIT",
  "author": "Alice-Marx",
  "icon": "icon.svg",
  "keywords": [
    "dsh",
    "deepseek",
    "plugin",
    "boot",
    "animation",
    "启动动画"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alice-Marx/dsh-boot-animation.git"
  },
  "homepage": "https://github.com/Alice-Marx/dsh-boot-animation#readme",
  "bugs": {
    "url": "https://github.com/Alice-Marx/dsh-boot-animation/issues"
  },
  "type": "module",
  "main": "entry.js",
  "exports": {
    ".": "./entry.js",
    "./client": {
      "default": "./lib/client.js"
    },
    "./locale/*": "./locale/*",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "assets",
    "lib",
    "src",
    "locale",
    "cordis.patch.yml",
    "entry.js",
    "icon.svg",
    "package.json",
    "README.md",
    "INSTALL.md",
    "MANUAL.md",
    "AGENTS.md"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.2"
    },
    "client": {
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
